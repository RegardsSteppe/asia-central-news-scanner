# Environment Configuration for Asia Central News Scanner
# Copy this file to .env and fill in your actual credentials

# Email Configuration (ProtonMail)
SENDER_EMAIL=your_email@proton.me
SENDER_PASSWORD=your_protonmail_password  # Use your ProtonMail password or app-specific password
RECIPIENT_EMAIL=recipient@proton.me

# SMTP Configuration for ProtonMail
SMTP_SERVER=smtp.protonmailrmez7hm6.onion
SMTP_PORT=1025

# Optional: Schedule time (24-hour format, Paris timezone)
SCHEDULE_TIME=08:00

# ProtonMail Bridge Configuration (if using Bridge)
# Uncomment below if using ProtonMail Bridge
# SMTP_SERVER=127.0.0.1
# SMTP_PORT=1025
